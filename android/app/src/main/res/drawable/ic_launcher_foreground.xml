<?xml version="1.0" encoding="utf-8"?>
<!-- Foreground: the pen that just finished the M, resting on the final
     stroke's endpoint. v3: taller M, steeper slender pen (segmented
     nib/body/cinnabar cap on one axis) so pen and M diagonals stop
     competing. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The M: taller, one continuous ink stroke -->
    <path
        android:pathData="M36.5,70 L36.5,38 L47.5,62 L58.5,38 L58.5,70"
        android:strokeColor="#2B2B33"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Pen, one axis at ~67 degrees, tip resting on the M's last point -->
    <!-- nib -->
    <path
        android:pathData="M58.5,70 L63.5,58"
        android:strokeColor="#2B2B33"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />
    <!-- barrel -->
    <path
        android:pathData="M64.1,56.6 L69,45"
        android:strokeColor="#2B2B33"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
    <!-- cinnabar cap -->
    <path
        android:pathData="M69,45 L71.5,39.1"
        android:strokeColor="#C3272B"
        android:strokeWidth="5.5"
        android:strokeLineCap="round" />
</vector>
